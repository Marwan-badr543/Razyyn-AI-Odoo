<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_razyyn" model="ir.module.category">
        <field name="name">Razyyn AI Accountant</field>
        <field name="description">AI Accounting Assistant &amp; Autonomous Agent Controls</field>
        <field name="sequence">20</field>
    </record>

    <!-- WHO MAY USE THE CHAT, AND WHO MAY CHANGE WHAT THE AGENT IS ALLOWED TO DO
         are two different questions, answered in two different places.

         The chat models — sessions, messages, the per-user platform login —
         are granted in ir.model.access.csv to `base.group_user`: every
         internal employee. They have to be. The chat page is published at
         auth="user", so any employee can open it, and an earlier version
         granted those models to the Razyyn User group below instead — a group
         nothing ever put anybody in, including the administrator. The page
         loaded and then answered 403 to every request it made.

         (Making `base.group_user` IMPLY this group looks like the tidier fix
         and does not work: Odoo skips a <record> that updates another module's
         noupdate data on a module UPDATE, so it silently applies on a fresh
         install and silently does nothing on an upgrade — the worst of both.)

         WHICH conversations each person sees is the record rules' job, below,
         and they are global so they bind everyone.

         This group and Manager remain what the GOVERNANCE records are granted
         to: the write policy, the audit log, the messaging credentials. An
         ordinary employee has no business reading what the agent has been
         authorised to post, or the company's mail credentials. -->
    <record id="group_razyyn_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_razyyn"/>
    </record>

    <record id="group_razyyn_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_razyyn"/>
        <field name="implied_ids" eval="[(4, ref('group_razyyn_user'))]"/>
        <!-- THE PERSON WHO INSTALLS THE MODULE IS IN IT.

             Six of this app's eight screens are granted to this group alone,
             and uid 2 is not the superuser, so without this line the
             administrator installs the module and finds a menu with two
             entries in it and no error to explain the other six. `(4, …)`
             only ever LINKS, so re-running it on an upgrade can neither take
             the group from somebody who has since been given it nor take
             anybody else out. Which other employees get it stays the
             customer's decision, in Settings > Users. -->
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- WHO SEES WHOSE CONVERSATIONS.
         These three rules carry NO `groups` field, which in Odoo makes them
         GLOBAL: they bind every user rather than only members of a particular
         group. That is the point. Access to the chat models is granted to
         every internal employee (see ir.model.access.csv), because the chat
         page is published at auth="user" and an employee who opens it must be
         able to use it. A rule scoped to a group would then apply to nobody
         who was not in that group — so every employee would see every other
         employee's conversations with the accountant, which is the opposite
         of what a per-group rule looks like it is doing.

         A global rule is also the safer direction to be wrong in: it can only
         ever narrow what someone sees.

         `groups` is set to an explicit empty list rather than simply left out.
         Omitting a field does not CLEAR it — Odoo leaves whatever is already
         there — so on an existing install the rules stayed bound to the Razyyn
         User group, a group nobody is in, and a rule that applies to nobody
         restricts nobody. Every employee could read every other employee's
         conversations, and the XML read as though they could not. -->
    <record id="razyyn_chat_session_own_rule" model="ir.rule">
        <field name="name">Own Chat Sessions</field>
        <field name="model_id" ref="model_razyyn_agent_chat_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="razyyn_chat_message_own_rule" model="ir.rule">
        <field name="name">Own Chat Messages</field>
        <field name="model_id" ref="model_razyyn_agent_chat_message"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <!-- One person's run is not another's. The chat stream is read with the
         signed-in user's own rights, so this rule is what stops a crafted
         last-event-id from replaying a colleague's audit into your window. -->
    <record id="razyyn_chat_event_own_rule" model="ir.rule">
        <field name="name">Razyyn chat events: your own runs only</field>
        <field name="model_id" ref="model_razyyn_agent_chat_event"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

</odoo>
