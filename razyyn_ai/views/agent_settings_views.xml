<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Razyyn Agent Settings Form View -->
    <record id="view_razyyn_agent_settings_form" model="ir.ui.view">
        <field name="name">razyyn.agent.settings.form</field>
        <field name="model">razyyn.agent.settings</field>
        <field name="arch" type="xml">
            <form string="Razyyn AI Settings">
                <header>
                    <button name="action_connect_platform" type="object" string="1-Click Connect" class="oe_highlight" invisible="is_platform_connected"/>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary" invisible="not is_platform_connected"/>
                    <button name="action_toggle_recording" type="object"
                            string="Enable Recording" class="btn-secondary"
                            invisible="not is_platform_connected or write_recording_enabled"/>
                    <button name="action_toggle_recording" type="object"
                            string="Disable Recording" class="btn-secondary"
                            invisible="not is_platform_connected or not write_recording_enabled"/>
                    <button name="action_rotate_keys" type="object" string="Rotate Keys" class="btn-secondary" confirm="Are you sure you want to rotate the agent credentials?" invisible="not is_platform_connected"/>
                    <button name="action_disconnect_platform" type="object" string="Disconnect" class="btn-danger" confirm="Are you sure you want to disconnect from Razyyn AI Platform?" invisible="not is_platform_connected"/>
                    <!-- Only when there is something to fix. A button offering
                         to install what is already installed is noise. -->
                    <button name="action_install_document_reading" type="object"
                            string="Install Document Reading" class="btn-secondary"
                            invisible="document_reading_ready"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="label" placeholder="Connection Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Platform Integration">
                            <field name="is_platform_connected" readonly="1"/>
                            <field name="connection_status" readonly="1"/>
                            <field name="platform_api_base_url"/>
                            <field name="erp_base_url"/>
                            <field name="write_connected_on" readonly="1"/>
                        </group>
                        <group string="Authentication &amp; User">
                            <field name="agent_erp_user_id"/>
                            <field name="api_key" password="True" readonly="1"/>
                            <field name="api_key_prefix" readonly="1"/>
                            <field name="access_token" password="True"/>
                        </group>
                    </group>
                    <group string="Write Operations &amp; Ledger Access">
                        <field name="write_recording_enabled"/>
                    </group>
                    <notebook>
                        <page string="Description &amp; Diagnostics">
                            <group>
                                <field name="write_last_error" readonly="1"/>
                            </group>
                            <group string="Reading Scanned Documents">
                                <field name="document_reading_ready" readonly="1"/>
                                <field name="document_reading_status" readonly="1" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Razyyn Agent Settings Tree View -->
    <record id="view_razyyn_agent_settings_tree" model="ir.ui.view">
        <field name="name">razyyn.agent.settings.tree</field>
        <field name="model">razyyn.agent.settings</field>
        <field name="arch" type="xml">
            <tree string="Razyyn AI Settings">
                <field name="label"/>
                <field name="platform_api_base_url"/>
                <field name="agent_erp_user_id"/>
                <field name="is_platform_connected"/>
                <field name="connection_status"/>
                <field name="write_recording_enabled"/>
                <field name="write_connected_on"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_razyyn_agent_settings" model="ir.actions.act_window">
        <field name="name">Agent Settings</field>
        <field name="res_model">razyyn.agent.settings</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Razyyn AI Platform Connection
            </p>
        </field>
    </record>
</odoo>
