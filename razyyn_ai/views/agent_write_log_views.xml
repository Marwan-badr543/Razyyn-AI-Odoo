<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Razyyn Agent Write Log Form View -->
    <record id="view_razyyn_agent_write_log_form" model="ir.ui.view">
        <field name="name">razyyn.agent.write.log.form</field>
        <field name="model">razyyn.agent.write.log</field>
        <field name="arch" type="xml">
            <form string="Agent Write Audit Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Transaction Metadata">
                            <field name="timestamp"/>
                            <field name="user_id"/>
                            <field name="session_id"/>
                            <field name="idempotency_key"/>
                        </group>
                        <group string="Target &amp; Status">
                            <field name="target_model"/>
                            <field name="target_record_id"/>
                            <field name="action_type"/>
                            <field name="status"/>
                            <field name="dry_run"/>
                        </group>
                    </group>
                    <group string="Rejection / Error" invisible="status not in ('rejected', 'failed')">
                        <field name="rejection_reason"/>
                        <field name="error_details"/>
                    </group>
                    <notebook>
                        <page string="Payload Data">
                            <field name="payload"/>
                        </page>
                        <page string="Response Data">
                            <field name="response_data"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Razyyn Agent Write Log Tree View -->
    <record id="view_razyyn_agent_write_log_tree" model="ir.ui.view">
        <field name="name">razyyn.agent.write.log.tree</field>
        <field name="model">razyyn.agent.write.log</field>
        <field name="arch" type="xml">
            <tree string="Agent Write Audit Logs" create="0" delete="0" decoration-danger="status in ('rejected', 'failed')" decoration-success="status == 'applied'" decoration-info="status == 'simulated'">
                <field name="timestamp"/>
                <field name="target_model"/>
                <field name="target_record_id"/>
                <field name="action_type"/>
                <field name="status"/>
                <field name="dry_run"/>
                <field name="user_id"/>
                <field name="rejection_reason"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_razyyn_agent_write_log" model="ir.actions.act_window">
        <field name="name">Write Audit Logs</field>
        <field name="res_model">razyyn.agent.write.log</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Audit trail of all agent write attempts, validations, and executions
            </p>
        </field>
    </record>
</odoo>
