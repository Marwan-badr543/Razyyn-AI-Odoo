     For license information, please see LICENSE

     Everything the chat keeps, where the customer can see it.

     These are not decoration. A conversation with an accounting agent is a
     business record: it is where a customer looks to find what they asked for
     and what was agreed, and what an auditor is shown when a posted entry is
     queried months later. On ERPNext all of it is in the desk by default. On
     Odoo a model with no view is invisible, which is why it is all here. -->
<odoo>

    <!-- ══ The chat itself, as a page of the application ═══════════════════ -->
    <record id="action_razyyn_chat" model="ir.actions.client">
        <field name="name">Razyyn AI</field>
        <field name="tag">razyyn_ai.chat</field>
    </record>

    <!-- ══ Conversations ═══════════════════════════════════════════════════ -->
    <record id="view_razyyn_chat_session_tree" model="ir.ui.view">
        <field name="name">razyyn.agent.chat.session.tree</field>
        <field name="model">razyyn.agent.chat.session</field>
        <field name="arch" type="xml">
            <tree string="Conversations">
                <field name="title"/>
                <field name="user_id"/>
                <field name="message_count" string="Messages"/>
                <field name="last_update"/>
                <field name="create_date" string="Started"/>
                <field name="session_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_razyyn_chat_session_form" model="ir.ui.view">
        <field name="name">razyyn.agent.chat.session.form</field>
        <field name="model">razyyn.agent.chat.session</field>
        <field name="arch" type="xml">
            <form string="Conversation">
                <header>
                    <button name="action_open_in_chat" type="object" string="Open in Razyyn AI"
                            class="btn-primary" icon="fa-comments"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title" class="oe_edit_only"/>
                        <h1><field name="title" placeholder="Conversation title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="last_update"/>
                        </group>
                        <group>
                            <field name="session_id" readonly="1"/>
                            <field name="backend_session_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transcript" name="transcript">
                            <field name="message_ids" readonly="1">
                                <tree>
                                    <field name="create_date" string="At"/>
                                    <field name="sender"/>
                                    <field name="content"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_razyyn_chat_session_search" model="ir.ui.view">
        <field name="name">razyyn.agent.chat.session.search</field>
        <field name="model">razyyn.agent.chat.session</field>
        <field name="arch" type="xml">
            <search string="Conversations">
                <field name="title"/>
                <field name="user_id"/>
                <field name="session_id"/>
                <filter name="mine" string="My conversations"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="recent" string="Updated this week"
                        domain="[('last_update', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_razyyn_chat_session" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">razyyn.agent.chat.session</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No conversations yet</p>
            <p>Open Razyyn AI and ask a question. Every conversation is kept here,
               with its full transcript.</p>
        </field>
    </record>

    <!-- ══ Messages ════════════════════════════════════════════════════════ -->
    <record id="view_razyyn_chat_message_tree" model="ir.ui.view">
        <field name="name">razyyn.agent.chat.message.tree</field>
        <field name="model">razyyn.agent.chat.message</field>
        <field name="arch" type="xml">
            <tree string="Messages" create="false">
                <field name="create_date" string="At"/>
                <field name="session_id"/>
                <field name="sender"/>
                <field name="content"/>
                <field name="agent_mode" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_razyyn_chat_message_form" model="ir.ui.view">
        <field name="name">razyyn.agent.chat.message.form</field>
        <field name="model">razyyn.agent.chat.message</field>
        <field name="arch" type="xml">
            <form string="Message" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="session_id"/>
                        <field name="sender"/>
                        <field name="create_date" string="At"/>
                        <field name="agent_mode"/>
                    </group>
                    <separator string="Content"/>
                    <field name="content" widget="text"/>
                    <field name="attachment_ids" widget="many2many_binary" string="Attachments"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_razyyn_chat_message_search" model="ir.ui.view">
        <field name="name">razyyn.agent.chat.message.search</field>
        <field name="model">razyyn.agent.chat.message</field>
        <field name="arch" type="xml">
            <search string="Messages">
                <field name="content"/>
                <field name="session_id"/>
                <filter name="from_customer" string="From the customer"
                        domain="[('sender', '=', 'human')]"/>
                <filter name="from_agent" string="From Razyyn AI"
                        domain="[('sender', '=', 'ai')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_session" string="Conversation"
                            context="{'group_by': 'session_id'}"/>
                    <filter name="group_sender" string="Sender"
                            context="{'group_by': 'sender'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_razyyn_chat_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">razyyn.agent.chat.message</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ══ The live stream's delivery buffer ═══════════════════════════════ -->
    <record id="view_razyyn_chat_event_tree" model="ir.ui.view">
        <field name="name">razyyn.agent.chat.event.tree</field>
        <field name="model">razyyn.agent.chat.event</field>
        <field name="arch" type="xml">
            <tree string="Stream Events" create="false">
                <field name="id"/>
                <field name="create_date" string="At"/>
                <field name="user_id"/>
                <field name="session_id"/>
                <field name="event"/>
            </tree>
        </field>
    </record>

    <record id="action_razyyn_chat_event" model="ir.actions.act_window">
        <field name="name">Stream Events</field>
        <field name="res_model">razyyn.agent.chat.event</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting</p>
            <p>Live progress is written here on its way to the chat window. Each
               conversation clears its own rows a minute after it finishes, so an
               empty list is the normal state — and a list with rows in it means
               either that somebody is being answered right now, or that a turn
               was stopped before it could tidy up.</p>
        </field>
    </record>

</odoo>
