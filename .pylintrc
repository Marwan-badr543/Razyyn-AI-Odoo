[MASTER]
load-plugins=pylint_odoo

[ODOOLINT]
readme-template-url=https://github.com/OCA/maintainer-tools/blob/master/template/module/README.rst

[MESSAGES CONTROL]
# This module ships to apps.odoo.com, not to an OCA repository, so the three
# OCA-org-only conventions below don't apply here:
#   manifest-required-author — OCA requires itself as a co-author; we're not OCA.
#   missing-readme           — OCA wants a README.rst generated by their own
#                               tooling; this repo's README.md is the real one
#                               (see static/description/index.html for the
#                               actual apps.odoo.com listing page).
#   manifest-deprecated-key  — OCA's newer style drops manifest "description"
#                               in favor of README.rst; we keep it as the short
#                               blurb Odoo's own backend Apps list renders.
disable=manifest-required-author,missing-readme,manifest-deprecated-key

# Usage: pylint --rcfile=.pylintrc -d all -e odoolint razyyn_ai
# NOTE: the disables above must be passed again on the command line AFTER
# `-e odoolint`, e.g.:
#   pylint --rcfile=.pylintrc -d all -e odoolint \
#       -d manifest-required-author,missing-readme,manifest-deprecated-key razyyn_ai
# `-e odoolint` is a category-enable that otherwise re-enables everything in
# this file's disable list, since pylint applies message-control args in the
# order given and category enables aren't overridden by an earlier specific
# disable from the config file.
