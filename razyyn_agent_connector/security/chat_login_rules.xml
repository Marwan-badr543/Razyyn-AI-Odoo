<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Row-level ownership for razyyn.chat.login: the access rights above
        grant base.group_user read/write/create/unlink on the MODEL, but say
        nothing about WHICH rows — without a rule any employee could list
        every colleague's stored access/refresh token via the generic Odoo
        UI (Settings > Technical, if enabled) or an XML-RPC call, not just
        through /razyyn/chat. This is the Odoo equivalent of the Frappe app's
        get_agent_settings_doc() owner check.
    -->
    <record id="razyyn_chat_login_own_only" model="ir.rule">
        <field name="name">Razyyn chat login: own record only</field>
        <field name="model_id" ref="model_razyyn_chat_login"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="razyyn_chat_login_system_all" model="ir.rule">
        <field name="name">Razyyn chat login: administrators see all</field>
        <field name="model_id" ref="model_razyyn_chat_login"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
